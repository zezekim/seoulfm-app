<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the home-screen widget (NowPlayingWidget), which reads what is on air. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.seoulfm.seoulfm</string>
	</array>
	<!-- Universal Links: seoul.fm pages open in the app (docs/deep-links.md). Release only: the free
	     team behind Dev.entitlements can't sign this capability. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:seoul.fm</string>
		<string>applinks:www.seoul.fm</string>
	</array>
	<!-- App Attest (lib/platform/attestation.dart). Production keys in every build signed with the
	     paid team: the API verifies against Apple's production root. Not in Dev.entitlements,
	     which free-team builds use and which can't carry it. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
